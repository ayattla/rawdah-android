rules_version = '2';
// قواعد روضة — نموذج «انعدام الثقة» (Zero-Trust):
// 1) كل شيء ممنوع ما لم يُسمح به صراحةً هنا.
// 2) لا يُوثق بأي قيمة من التطبيق: الأشكال والحدود والأوقات يتحقق منها الخادم.
// 3) لا نص حر إطلاقًا: الألقاب وأسماء الحلقات تُركّب من قوائم معتمدة ويطابقها الخادم حرفيًا، ولا يوجد أي حقل رسائل.
// 4) حد السرعة لكل مستخدم: أقصى 60 نقطة كل 8 ثوانٍ، مهما كان عدد الأطفال على الجهاز.
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------ أدوات مشتركة
    function signedIn() { return request.auth != null; }
    function isUid(uid) { return signedIn() && request.auth.uid == uid; }
    // معرّف اللاعب = uid الجهاز + _ + معرّف الطفل
    function owns(pid) { return signedIn() && pid.matches(request.auth.uid + '_[A-Za-z0-9]{1,40}'); }
    function data() { return request.resource.data; }
    function stamped(field) { return data()[field] == request.time; }
    // لا نص حر: اللقب يجب أن يطابق حرفيًا تركيب جزأين من القائمتين المعتمدتين
    // (القوائم نفسها في lib/core/content/names.dart، ويتحقق اختبار آلي من تطابقها)
    function nickFirst() { return ['نجم', 'بدر', 'قمر', 'نور', 'سراج', 'لؤلؤ', 'ياقوت', 'غيث', 'نسيم', 'ريحان', 'زهر', 'فجر', 'ضياء', 'سنا', 'أمل', 'شهاب']; }
    function nickSecond() { return ['الهدى', 'الإيمان', 'الخير', 'السلام', 'الفجر', 'الروضة', 'العلم', 'الصباح', 'الأمل', 'الوفاء', 'الصدق', 'البر', 'الرحمة', 'الحكمة', 'المعرفة', 'النقاء']; }
    function okNickParts(nick, a, b) {
      return a is int && b is int && a >= 0 && a < nickFirst().size() && b >= 0 && b < nickSecond().size()
        && nick == nickFirst()[a] + ' ' + nickSecond()[b];
    }
    function okSymbolValue(v) { return v in ['star', 'moon', 'sun', 'tree', 'book', 'gem']; }
    function okIdentity() { return okNickParts(data().nick, data().na, data().nb) && okSymbolValue(data().symbol); }
    function okCode(code) { return code.matches('[A-Z0-9]{6}'); }

    // ------------------------------------------------------------ حد السرعة لكل مستخدم
    // كل دفعة نقاط يجب أن تكتب معها limits/{uid} في الدفعة نفسها بوقت الخادم،
    // ولا تُقبل كتابته إلا بعد مرور 8 ثوانٍ على آخر دفعة، ولطفل واحد في كل دفعة.
    function limitDoc() { return /databases/$(database)/documents/limits/$(request.auth.uid); }
    function throttled(pid) {
      return getAfter(limitDoc()).data.at == request.time && getAfter(limitDoc()).data.pid == pid;
    }
    function okLimitShape() {
      return data().keys().hasOnly(['at', 'pid']) && stamped('at') && owns(data().pid);
    }
    match /limits/{uid} {
      allow get: if isUid(uid);
      allow create: if isUid(uid) && okLimitShape();
      allow update: if isUid(uid) && okLimitShape() && request.time > resource.data.at + duration.value(8, 's');
    }

    // نقاط في ملف منافسة: تزيد فقط، بحد أقصى 60 في الدفعة، ومع حد السرعة
    function pointsCreate(pid, field) {
      return data()[field] is int && data()[field] >= 0 && data()[field] <= 60
        && (data()[field] == 0 || throttled(pid));
    }
    function pointsUpdate(pid, field) {
      return data()[field] is int
        && data()[field] >= resource.data[field]
        && data()[field] <= resource.data[field] + 60
        && throttled(pid);
    }
    function entryShape() { return data().keys().hasOnly(['nick', 'na', 'nb', 'symbol', 'points', 'updatedAt']) && okIdentity() && stamped('updatedAt'); }

    // ------------------------------------------------------------ لوحات الترتيب
    match /players/{pid} {
      allow read: if signedIn();
      allow create: if owns(pid)
        && data().keys().hasOnly(['nick', 'na', 'nb', 'symbol', 'band', 'total', 'updatedAt'])
        && okIdentity() && data().band in [0, 1, 2] && stamped('updatedAt')
        && pointsCreate(pid, 'total');
      allow update: if owns(pid)
        && data().keys().hasOnly(['nick', 'na', 'nb', 'symbol', 'band', 'total', 'updatedAt'])
        && okIdentity() && data().band in [0, 1, 2] && stamped('updatedAt')
        && pointsUpdate(pid, 'total');
      allow delete: if owns(pid);
    }

    match /leagues/{week}/entries/{pid} {
      allow read: if signedIn();
      allow create: if owns(pid) && week.matches('w[0-9]{1,5}_b[0-2]') && entryShape() && pointsCreate(pid, 'points');
      allow update: if owns(pid) && entryShape() && pointsUpdate(pid, 'points');
      allow delete: if owns(pid);
    }

    match /cups/{cup}/entries/{pid} {
      allow read: if signedIn();
      allow create: if owns(pid) && cup.matches('r[0-9]{4}_b[0-2]') && entryShape() && pointsCreate(pid, 'points');
      allow update: if owns(pid) && entryShape() && pointsUpdate(pid, 'points');
      allow delete: if owns(pid);
    }

    // ------------------------------------------------------------ حلقات المعلم
    // لا يمكن سرد الحلقات؛ لا يصل إلى الحلقة إلا من يعرف رمزها.
    match /circles/{code} {
      function circle() { return get(/databases/$(database)/documents/circles/$(code)).data; }
      allow get: if signedIn();
      allow list: if false;
      // اسم الحلقة: رقم من قائمة الأسماء المعتمدة (12 اسمًا) ورقم الحلقة، بلا نص
      allow create: if signedIn() && okCode(code)
        && data().keys().hasOnly(['nameKey', 'num', 'owner', 'createdAt'])
        && data().nameKey is int && data().nameKey >= 0 && data().nameKey < 12
        && data().num is int && data().num >= 1 && data().num <= 99
        && data().owner == request.auth.uid && stamped('createdAt');
      allow update: if false;
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;

      match /members/{pid} {
        allow read: if signedIn();
        // الانضمام بصفر نقطة فقط؛ من أُخرج لا يعود بنقاطه إلا بانضمام جديد
        allow create: if owns(pid) && exists(/databases/$(database)/documents/circles/$(code))
          && entryShape() && data().points == 0;
        allow update: if owns(pid) && exists(/databases/$(database)/documents/circles/$(code))
          && entryShape() && pointsUpdate(pid, 'points');
        allow delete: if owns(pid) || (signedIn() && circle().owner == request.auth.uid);
      }
    }

    // ------------------------------------------------------------ المسابقة المباشرة
    match /rooms/{code} {
      function room() { return get(/databases/$(database)/documents/rooms/$(code)).data; }
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && okCode(code)
        && data().keys().hasOnly(['owner', 'band', 'qids', 'index', 'state', 'createdAt'])
        && data().owner == request.auth.uid
        && data().band in [0, 1, 2]
        && data().qids is list && data().qids.size() >= 3 && data().qids.size() <= 15
        && data().index == 0 && data().state == 'wait' && stamped('createdAt');
      allow update: if signedIn() && resource.data.owner == request.auth.uid
        && data().diff(resource.data).affectedKeys().hasOnly(['index', 'state'])
        && data().state in ['wait', 'q', 'end']
        && data().index is int && data().index >= 0 && data().index < resource.data.qids.size();
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;

      match /players/{pid} {
        allow read: if signedIn();
        allow create: if owns(pid) && exists(/databases/$(database)/documents/rooms/$(code))
          && data().keys().hasOnly(['nick', 'na', 'nb', 'symbol', 'score', 'answered', 'updatedAt'])
          && okIdentity() && data().score == 0 && data().answered == -1 && stamped('updatedAt');
        // إجابة واحدة لكل سؤال، أثناء عرضه فقط، ونقطة واحدة كحد أقصى
        allow update: if owns(pid)
          && data().diff(resource.data).affectedKeys().hasOnly(['score', 'answered', 'updatedAt'])
          && room().state == 'q'
          && data().answered == room().index
          && data().answered > resource.data.answered
          && data().score is int && data().score >= resource.data.score && data().score <= resource.data.score + 1
          && stamped('updatedAt');
        allow delete: if owns(pid) || (signedIn() && room().owner == request.auth.uid);
      }
    }

    // ------------------------------------------------------------ تحدي صديق
    match /challenges/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && okCode(code)
        && data().keys().hasOnly(['band', 'qids', 'aNick', 'aNa', 'aNb', 'aSymbol', 'aScore', 'createdAt'])
        && data().band in [0, 1, 2]
        && data().qids is list && data().qids.size() == 5
        && okNickParts(data().aNick, data().aNa, data().aNb) && okSymbolValue(data().aSymbol)
        && data().aScore is int && data().aScore >= 0 && data().aScore <= 5
        && stamped('createdAt');
      // الصديق يضيف نتيجته مرة واحدة فقط
      allow update: if signedIn() && !('bScore' in resource.data)
        && data().diff(resource.data).affectedKeys().hasOnly(['bNick', 'bNa', 'bNb', 'bSymbol', 'bScore', 'bAt'])
        && okNickParts(data().bNick, data().bNa, data().bNb) && okSymbolValue(data().bSymbol)
        && data().bScore is int && data().bScore >= 0 && data().bScore <= 5
        && stamped('bAt');
      allow delete: if false;
    }

    // ------------------------------------------------------------ البلاغات
    // إنشاء فقط، ويراجعها المشرف من لوحة Firebase. لا يقرؤها أحد من التطبيق.
    match /reports/{rid} {
      allow read, update, delete: if false;
      allow create: if signedIn()
        && data().keys().hasOnly(['target', 'createdAt'])
        && data().target is string && data().target.size() < 80
        && stamped('createdAt');
    }
  }
}
