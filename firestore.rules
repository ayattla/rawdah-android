rules_version = '2';
// قواعد روضة: منافسة بالألقاب فقط، بلا أي تواصل بين الأطفال.
// كل جهاز يدخل دخولًا مجهولًا، ولا يكتب إلا ملفات أطفاله، والنقاط تزيد بحد أقصى 60 كل 8 ثوانٍ.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(pid) { return signedIn() && pid.matches(request.auth.uid + '_[A-Za-z0-9]+'); }
    function okNick(d) { return d.nick is string && d.nick.size() >= 2 && d.nick.size() <= 24; }
    function okSymbol(d) { return d.symbol in ['star', 'moon', 'sun', 'tree', 'book', 'gem']; }
    function stamped(d) { return d.updatedAt == request.time; }
    function slow() { return request.time > resource.data.updatedAt + duration.value(8, 's'); }

    match /players/{pid} {
      allow read: if signedIn();
      allow create: if owns(pid)
        && request.resource.data.keys().hasOnly(['nick', 'symbol', 'band', 'total', 'updatedAt'])
        && okNick(request.resource.data) && okSymbol(request.resource.data)
        && request.resource.data.band in [0, 1, 2]
        && request.resource.data.total is int
        && request.resource.data.total >= 0 && request.resource.data.total <= 60
        && stamped(request.resource.data);
      allow update: if owns(pid)
        && request.resource.data.keys().hasOnly(['nick', 'symbol', 'band', 'total', 'updatedAt'])
        && okNick(request.resource.data) && okSymbol(request.resource.data)
        && request.resource.data.band in [0, 1, 2]
        && request.resource.data.total is int
        && request.resource.data.total >= resource.data.total
        && request.resource.data.total <= resource.data.total + 60
        && stamped(request.resource.data) && slow();
      allow delete: if owns(pid);
    }

    match /leagues/{week}/entries/{pid} {
      allow read: if signedIn();
      allow create: if owns(pid) && week.matches('w[0-9]+_b[0-2]')
        && request.resource.data.keys().hasOnly(['nick', 'symbol', 'points', 'updatedAt'])
        && okNick(request.resource.data) && okSymbol(request.resource.data)
        && request.resource.data.points is int
        && request.resource.data.points >= 0 && request.resource.data.points <= 60
        && stamped(request.resource.data);
      allow update: if owns(pid)
        && request.resource.data.keys().hasOnly(['nick', 'symbol', 'points', 'updatedAt'])
        && okNick(request.resource.data) && okSymbol(request.resource.data)
        && request.resource.data.points is int
        && request.resource.data.points >= resource.data.points
        && request.resource.data.points <= resource.data.points + 60
        && stamped(request.resource.data) && slow();
      allow delete: if owns(pid);
    }

    // إبلاغ عن لقب غير لائق: إنشاء فقط، ويراجعه المشرف من لوحة Firebase.
    // كأس رمضان: مثل الدوري الأسبوعي تمامًا لكن بمفتاح الكأس.
    match /cups/{cup}/entries/{pid} {
      allow read: if signedIn();
      allow create: if owns(pid) && cup.matches('r[0-9]+_b[0-2]')
        && request.resource.data.keys().hasOnly(['nick', 'symbol', 'points', 'updatedAt'])
        && okNick(request.resource.data) && okSymbol(request.resource.data)
        && request.resource.data.points is int
        && request.resource.data.points >= 0 && request.resource.data.points <= 60
        && stamped(request.resource.data);
      allow update: if owns(pid)
        && request.resource.data.keys().hasOnly(['nick', 'symbol', 'points', 'updatedAt'])
        && okNick(request.resource.data) && okSymbol(request.resource.data)
        && request.resource.data.points is int
        && request.resource.data.points >= resource.data.points
        && request.resource.data.points <= resource.data.points + 60
        && stamped(request.resource.data) && slow();
      allow delete: if owns(pid);
    }

    // الحلقات: المعلم ينشئ حلقة برمز، والأطفال ينضمون بالرمز ويظهرون بالألقاب والنقاط فقط.
    match /circles/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && code.matches('[A-Z0-9]{6}')
        && request.resource.data.keys().hasOnly(['name', 'owner', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 30
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;

      match /members/{pid} {
        allow read: if signedIn();
        allow create: if owns(pid)
          && exists(/databases/$(database)/documents/circles/$(code))
          && request.resource.data.keys().hasOnly(['nick', 'symbol', 'points', 'updatedAt'])
          && okNick(request.resource.data) && okSymbol(request.resource.data)
          && request.resource.data.points is int
          && request.resource.data.points >= 0 && request.resource.data.points <= 60
          && stamped(request.resource.data);
        allow update: if owns(pid)
          && exists(/databases/$(database)/documents/circles/$(code))
          && request.resource.data.keys().hasOnly(['nick', 'symbol', 'points', 'updatedAt'])
          && okNick(request.resource.data) && okSymbol(request.resource.data)
          && request.resource.data.points is int
          && request.resource.data.points >= resource.data.points
          && request.resource.data.points <= resource.data.points + 60
          && stamped(request.resource.data) && slow();
        allow delete: if owns(pid)
          || (signedIn() && get(/databases/$(database)/documents/circles/$(code)).data.owner == request.auth.uid);
      }
    }

    // المسابقة المباشرة: المعلم يدير الغرفة، والطفل يكتب إجابته مرة لكل سؤال وتزيد نقطته بواحد كحد أقصى.
    match /rooms/{code} {
      function roomData() { return get(/databases/$(database)/documents/rooms/$(code)).data; }
      allow read: if signedIn();
      allow create: if signedIn() && code.matches('[A-Z0-9]{6}')
        && request.resource.data.keys().hasOnly(['owner', 'band', 'qids', 'index', 'state', 'createdAt'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.band in [0, 1, 2]
        && request.resource.data.qids is list
        && request.resource.data.qids.size() >= 3 && request.resource.data.qids.size() <= 15
        && request.resource.data.index == 0 && request.resource.data.state == 'wait'
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && resource.data.owner == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['index', 'state'])
        && request.resource.data.state in ['wait', 'q', 'end']
        && request.resource.data.index is int && request.resource.data.index >= 0
        && request.resource.data.index < resource.data.qids.size();
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;

      match /players/{pid} {
        allow read: if signedIn();
        allow create: if owns(pid)
          && exists(/databases/$(database)/documents/rooms/$(code))
          && request.resource.data.keys().hasOnly(['nick', 'symbol', 'score', 'answered', 'updatedAt'])
          && okNick(request.resource.data) && okSymbol(request.resource.data)
          && request.resource.data.score == 0 && request.resource.data.answered == -1
          && stamped(request.resource.data);
        allow update: if owns(pid)
          && request.resource.data.keys().hasOnly(['nick', 'symbol', 'score', 'answered', 'updatedAt'])
          && request.resource.data.nick == resource.data.nick
          && request.resource.data.symbol == resource.data.symbol
          && roomData().state == 'q'
          && request.resource.data.answered == roomData().index
          && request.resource.data.answered > resource.data.answered
          && request.resource.data.score is int
          && request.resource.data.score >= resource.data.score
          && request.resource.data.score <= resource.data.score + 1
          && stamped(request.resource.data);
        allow delete: if owns(pid)
          || (signedIn() && get(/databases/$(database)/documents/rooms/$(code)).data.owner == request.auth.uid);
      }
    }

    // تحدي صديق: المنشئ يكتب نتيجته، والصديق يضيف نتيجته مرة واحدة فقط.
    match /challenges/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && code.matches('[A-Z0-9]{6}')
        && request.resource.data.keys().hasOnly(['band', 'qids', 'aNick', 'aSymbol', 'aScore', 'createdAt'])
        && request.resource.data.band in [0, 1, 2]
        && request.resource.data.qids is list && request.resource.data.qids.size() == 5
        && request.resource.data.aNick is string && request.resource.data.aNick.size() <= 24
        && request.resource.data.aSymbol in ['star', 'moon', 'sun', 'tree', 'book', 'gem']
        && request.resource.data.aScore is int && request.resource.data.aScore >= 0 && request.resource.data.aScore <= 5
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && !('bScore' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bNick', 'bSymbol', 'bScore', 'bAt'])
        && request.resource.data.bNick is string && request.resource.data.bNick.size() <= 24
        && request.resource.data.bSymbol in ['star', 'moon', 'sun', 'tree', 'book', 'gem']
        && request.resource.data.bScore is int && request.resource.data.bScore >= 0 && request.resource.data.bScore <= 5
        && request.resource.data.bAt == request.time;
    }

    match /reports/{rid} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['target', 'createdAt'])
        && request.resource.data.target is string && request.resource.data.target.size() < 80
        && request.resource.data.createdAt == request.time;
    }
  }
}
